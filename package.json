{
  "name": "nestro-ui-kit_v2",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/nestro-ui-kit.umd.js",
  "module": "dist/nestro-ui-kit.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nestro-ui-kit.es.js",
      "require": "./dist/nestro-ui-kit.umd.js"
    },
    "./nestro-ui-kit.css": "./dist/nestro-ui-kit.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview:ui": "vite --config vite.preview.config.ts",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint --ext .js,.ts,.vue src",
    "lint:fix": "eslint --ext .js,.ts,.vue src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:tokens": "tsx --tsconfig tsconfig.scripts.json ./src/scripts/generate-tokens.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "pack": "npm run build && npm pack",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue,css,scss,md,json}": [
      "prettier --write"
    ],
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "peerDependencies": {
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.30.0",
    "@storybook/addon-essentials": "8.6.9",
    "@storybook/experimental-addon-test": "8.6.9",
    "@storybook/test": "8.6.9",
    "@storybook/vue3": "8.6.9",
    "@storybook/vue3-vite": "8.6.9",
    "@types/node": "25.3.0",
    "@typescript-eslint/eslint-plugin": "7.9.0",
    "@typescript-eslint/parser": "7.9.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/tsconfig": "0.7.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-vue": "9.23.0",
    "husky": "9.1.7",
    "lint-staged": "16.3.3",
    "prettier": "3.2.5",
    "sass": "1.89.2",
    "storybook": "^8.6.18",
    "tsx": "4.21.0",
    "typescript": "5.7.2",
    "vite": "^6.4.1",
    "vite-plugin-dts": "4.5.4",
    "vite-svg-loader": "5.1.0",
    "vue": "3.5.13",
    "vue-tsc": "2.2.4"
  }
}
